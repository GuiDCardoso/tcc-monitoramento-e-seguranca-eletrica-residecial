generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

model Usuario {
  id          String       @id @default(uuid())
  nome        String
  email       String       @unique
  senha       String
  role        Role         @default(CLIENTE)
  residencias Residencia[]
  criadoEm    DateTime     @default(now())
}

model Residencia {
  id          Int         @id @default(autoincrement())
  nome        String      // Ex: "Casa Principal"
  usuarioId   String      // <-- Atualizado para String para conectar com Usuario
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  disjuntores Disjuntor[]
  criadoEm    DateTime    @default(now())
}

model Disjuntor {
  id             Int        @id @default(autoincrement())
  nome           String     // Ex: "Geral", "Chuveiro", "Ar-condicionado"
  limiteCorrente Float      // Limiar de segurança em Amperes (para disparar o alerta)
  residenciaId   Int
  residencia     Residencia @relation(fields: [residenciaId], references: [id], onDelete: Cascade)
  leituras       Leitura[]
}

model Leitura {
  id           Int        @id @default(autoincrement())
  tensaoRms    Float
  correnteRms  Float
  potencia     Float
  alerta       Boolean    @default(false)
  disjuntorId  Int
  disjuntor    Disjuntor  @relation(fields: [disjuntorId], references: [id], onDelete: Cascade)
  registradoEm DateTime   @default(now())
}